// Constellation: niri, the scrolling tiling compositor, with the Caelestia shell.
// This is the system default (/etc/niri/config.kdl). To change it, copy it first:
//   mkdir -p ~/.config/niri && cp /etc/niri/config.kdl ~/.config/niri/
// Super+Shift+/ shows every key binding.

input {
    keyboard {
        xkb {
            // Alt+Shift switches between English and Russian (ЙЦУКЕН).
            layout "gb,ru"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
        dwt
        accel-profile "adaptive"
    }
    focus-follows-mouse max-scroll-amount="0%"
}

// The Framework 13 Pro's panel; niri picks the right scale by itself, this just fixes it at 2.
output "eDP-1" {
    scale 2
}

layout {
    gaps 12
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 3
        active-color "#5b84c8"
        inactive-color "#2a3550"
    }
    border { off; }
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d %H-%M-%S.png"

environment {
    QT_QPA_PLATFORM "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// The shell, X11 apps, clipboard history and the password prompt agent.
spawn-at-startup "/usr/lib/constellation/start-shell"
spawn-at-startup "xwayland-satellite"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"

hotkey-overlay {
    skip-at-startup
}

layer-rule {
    match namespace="quickshell:Backdrop"
    place-within-backdrop true
}

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

binds {
    // Super+Shift+/ shows this list on screen.
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Workstations
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Tab repeat=false hotkey-overlay-title="Overview" { toggle-overview; }

    // Applications
    Mod+W hotkey-overlay-title="Firefox" { spawn "firefox"; }
    Mod+T hotkey-overlay-title="kitty" { spawn "kitty"; }
    Mod+D hotkey-overlay-title="Discord" { spawn "discord"; }
    Mod+V hotkey-overlay-title="VLC" { spawn "vlc"; }
    Mod+E hotkey-overlay-title="File manager" { spawn "dolphin"; }
    Mod+Space repeat=false hotkey-overlay-title="Launcher" { spawn-sh "qs -c niri-caelestia-shell ipc call drawers toggle launcher"; }
    Mod+A hotkey-overlay-title="ani-cli" { spawn "kitty" "--title" "ani-cli" "ani-cli"; }
    Mod+P hotkey-overlay-title="Proton VPN" { spawn "protonvpn-app"; }
    Mod+Alt+R hotkey-overlay-title="Russian words" { spawn "kitty" "constellation-russian" "--pause" "words"; }

    // Windows (Super+left drag moves a window, Super+right drag resizes it: built into niri)
    Mod+Q repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+R hotkey-overlay-title="Cycle column width" { switch-preset-column-width; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Moving around the strip of windows
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // Caelestia shell panels
    Mod+Shift+D repeat=false hotkey-overlay-title="Dashboard" { spawn-sh "qs -c niri-caelestia-shell ipc call drawers toggle dashboard"; }
    Mod+N repeat=false hotkey-overlay-title="Utilities" { spawn-sh "qs -c niri-caelestia-shell ipc call drawers toggle utilities"; }
    Mod+Shift+N repeat=false hotkey-overlay-title="Notifications" { spawn-sh "qs -c niri-caelestia-shell ipc call drawers toggle sidebar"; }
    Mod+Shift+V repeat=false hotkey-overlay-title="Clipboard history" { spawn-sh "qs -c niri-caelestia-shell ipc call clipboard toggle"; }
    Mod+Shift+W repeat=false hotkey-overlay-title="Wallpaper" { spawn-sh "qs -c niri-caelestia-shell ipc call wallpaper toggle"; }
    Mod+Escape hotkey-overlay-title="Power menu" { spawn-sh "qs -c niri-caelestia-shell ipc call drawers toggle session"; }

    // Session
    Mod+X allow-when-locked=true hotkey-overlay-title="Lock" { spawn-sh "qs -c niri-caelestia-shell ipc call lock lock"; }
    Mod+Z hotkey-overlay-title="Suspend" { spawn-sh "qs -c niri-caelestia-shell ipc call lock lock; sleep 1; systemctl suspend"; }
    Mod+Shift+E { quit; }

    // Screenshots
    Mod+Shift+S hotkey-overlay-title="Screenshot a region" { spawn-sh "grim -g \"$(slurp)\" - | swappy -f -"; }
    Print { screenshot; }

    // Keyboard and media
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}
