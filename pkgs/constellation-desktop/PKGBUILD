# Constellation desktop: the Hyperon compositor with the Caelestia shell, and the apps and services around it.
pkgname=constellation-desktop
pkgver=0.3.0
pkgrel=1
pkgdesc='Constellation desktop: Hyperon, the Caelestia shell, greetd and the everyday apps'
arch=('any')
url='https://github.com/factionparadox/Constellation'
license=('MIT')
depends=(
  'constellation-base'
  # compositor, shell, login
  'hyperon' 'caelestia-shell' 'xorg-xwayland' 'greetd' 'greetd-tuigreet'
  'xdg-desktop-portal-gtk' 'polkit-kde-agent' 'gnome-keyring'
  # sound, network, Bluetooth, power, hardware
  'pipewire' 'pipewire-pulse' 'pipewire-alsa' 'wireplumber' 'pavucontrol' 'playerctl'
  'networkmanager' 'bluez' 'bluez-utils' 'power-profiles-daemon' 'fwupd' 'fprintd'
  'mesa' 'vulkan-intel' 'intel-media-driver' 'sof-firmware' 'brightnessctl'
  # apps
  'kitty' 'fish' 'dolphin' 'firefox' 'discord' 'vlc' 'vlc-plugins-all' 'ani-cli' 'proton-vpn-gtk-app'
  'grim' 'slurp' 'swappy' 'mpv' 'fastfetch' 'btop'
  # fonts (Inter and Material Symbols for the login screen, as on the boot menu)
  'inter-font' 'ttf-material-symbols-rounded' 'quickshell-git'
  'noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji' 'ttf-jetbrains-mono-nerd'
)
install=constellation-desktop.install
source=('hyperon.conf' 'start-shell' 'greetd.toml' 'greetd-constellation.conf' 'shell.json' 'wallpaper.png'
        'shell.qml' 'Greeter.qml' 'Sky.qml' 'greeter-hyperon.conf'
        'constellation-greeter' 'constellation-greeter.tmpfiles'
        'constellation-logo.png' 'fastfetch-logo.txt' 'fastfetch.jsonc')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm0644 hyperon.conf "$pkgdir/etc/xdg/hyperon/hyperon.conf"
  install -Dm0755 start-shell "$pkgdir/usr/lib/constellation/start-shell"
  install -Dm0644 greetd.toml "$pkgdir/etc/greetd/constellation.toml"
  install -Dm0644 greetd-constellation.conf "$pkgdir/usr/lib/systemd/system/greetd.service.d/constellation.conf"
  install -Dm0644 shell.json "$pkgdir/etc/skel/.config/caelestia/shell.json"
  # the graphical login screen
  for f in shell.qml Greeter.qml Sky.qml; do
    install -Dm0644 "$f" "$pkgdir/usr/share/constellation/greeter/$f"
  done
  install -Dm0644 greeter-hyperon.conf "$pkgdir/usr/share/constellation/greeter/hyperon.conf"
  install -Dm0755 constellation-greeter "$pkgdir/usr/lib/constellation/greeter"
  install -Dm0644 constellation-greeter.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/constellation-greeter.conf"
  # the Constellation mark, and fastfetch drawing it in its own colours
  install -Dm0644 constellation-logo.png "$pkgdir/usr/share/pixmaps/constellation.png"
  install -Dm0644 fastfetch-logo.txt "$pkgdir/usr/share/constellation/fastfetch/constellation.txt"
  install -Dm0644 fastfetch.jsonc "$pkgdir/etc/skel/.config/fastfetch/config.jsonc"
  install -Dm0644 wallpaper.png "$pkgdir/usr/share/backgrounds/constellation/constellation.png"
}
