// niri for the login screen only: no key bindings, nothing but Constellation's greeter.
// When the greeter exits (a session is starting, or it crashed), niri exits too.
input {
    keyboard {
        xkb {
            layout "gb,ru"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}

output "eDP-1" {
    scale 2
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

spawn-sh-at-startup "qs -p /usr/share/constellation/greeter/shell.qml; niri msg action quit --skip-confirmation"

binds {
}
