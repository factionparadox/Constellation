#!/usr/bin/env python3
"""constellation-russian: learn Russian from the alphabet to B2, offline.

    constellation-russian path                       the route from A1 to B2, with your word progress
    constellation-russian tutor [TEXT] [--level B1]  the local AI tutor (no TEXT: a conversation)
    constellation-russian words [--level A2] [--new N] [--reverse] [--say] [--stats]
    constellation-russian listen [--level B1] [--play N | --pick]
    constellation-russian read mezhdunami|wikisource|wikipedia|wiktionary-ru|wiktionary
    constellation-russian say TEXT [--voice irina|denis|dmitri|ruslan] [--output file.wav]
    constellation-russian library [--open]
    constellation-russian dictionary

Large material (AI tutor, voices, courses, audiobooks, dictionaries) is downloaded with
constellation-content; each command says which pack it needs if it is missing.
"""
from __future__ import annotations

import argparse
import datetime
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from urllib import error, request

