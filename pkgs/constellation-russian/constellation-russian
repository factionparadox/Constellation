SHARE = Path(os.environ.get('CONSTELLATION_RUSSIAN_SHARE', '/usr/share/constellation/russian'))
DATA = Path(os.environ.get('CONSTELLATION_RUSSIAN_DATA', '/var/lib/constellation/russian'))
CONFIG = DATA / 'russian.json'        # written by constellation-content
DEFAULTS = {
    'model': 'qwen3:30b-a3b-instruct-2507-q4_K_M',
    'piper': '/usr/lib/constellation/piper/piper',
    'voices': str(DATA / 'voices'),
    'library': str(DATA / 'library'),
    'audiobooks': str(DATA / 'audiobooks'),
    'mezhdunami': str(DATA / 'mezhdunami'),
    'vocab': str(SHARE / 'vocab.tsv'),
    'kiwix': {},
}
STATE = Path(os.environ.get('CONSTELLATION_WORDS_STATE',
                            Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share'))
                            / 'constellation/russian-words.json'))
VOCAB_LEVELS = ('A1', 'A2', 'B1', 'B2')
LEVELS = ('A1', 'A2', 'B1', 'B2', 'C1', 'C2')
