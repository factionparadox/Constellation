# Caelestia desktop shell, ported to niri (Cantfirmed's fork, which keeps merging upstream
# Caelestia releases). Pinned to a reviewed commit; bump _commit and pkgver together.
pkgname=niri-caelestia-shell
pkgver=2.5.0.r20261026
pkgrel=1
_commit=178fb02fb0378f450d1d88e433615111699ebdba
_upstream=2.5.0
pkgdesc='Caelestia, a Quickshell desktop shell, for the niri compositor'
arch=('x86_64')
url='https://github.com/Cantfirmed/niri-caelestia-shell'
license=('GPL-3.0-only')
depends=(
  'quickshell-git' 'niri' 'qt6-base' 'qt6-declarative' 'qt6-shadertools' 'qt6-svg' 'qt6-wayland'
  'caelestia-cli' 'libqalculate' 'libpipewire' 'aubio' 'libcava' 'fftw'
  'pipewire' 'wireplumber' 'networkmanager' 'lm_sensors' 'brightnessctl' 'ddcutil'
  'wl-clipboard' 'cliphist' 'app2unit' 'swappy' 'grim' 'slurp'
  'fish' 'bash' 'python' 'jq' 'libnotify' 'libxml2'
  'ttf-rubik-vf' 'ttf-material-symbols-variable-git' 'ttf-cascadia-code-nerd'
)
makedepends=('git' 'cmake' 'ninja' 'pkgconf')
optdepends=('gpu-screen-recorder: screen recording from the shell'
            'matugen: colour schemes from the wallpaper')
source=("$pkgname::git+https://github.com/Cantfirmed/niri-caelestia-shell.git#commit=$_commit")
sha256sums=('SKIP')    # a git commit pin is itself a hash of the whole tree

build() {
  # Installed as the niri-caelestia-shell Quickshell config, the name its niri key bindings use.
  cmake -S "$pkgname" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_SYSCONFDIR=/etc \
    -DVERSION="$_upstream" -DGIT_REVISION="$_commit" -DDISTRIBUTOR=Constellation \
    -DINSTALL_QSCONFDIR=/etc/xdg/quickshell/niri-caelestia-shell
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm0644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
