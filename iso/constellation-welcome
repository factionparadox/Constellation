#!/bin/sh
cat <<'TXT'
Созвездие / Constellation

Installing erases one whole disk and gives you:
  * an OpenZFS root with boot environments: updates go into a copy of the system
    (sudo constellation-be upgrade), so a bad update never touches the one you are using
  * ZFSBootMenu to boot any boot environment or snapshot
  * MangoWM and the Caelestia shell, the birthDate-free systemd, zram instead of swap
  * the Russian kit (constellation-russian; downloads with constellation-content)

Everything is on this USB stick: installing needs no internet connection.
  Install:   constellation-install
  Rehearse:  constellation-install --dry-run   (shows every step, changes nothing)
TXT
if [ "${1:-}" = --offer ] && [ ! -e /run/constellation-offered ]; then
  : > /run/constellation-offered
  printf '\nStart the installer now? [Y/n] '
  read -r a || a=n
  case "$a" in [nN]*) echo 'You are at a root shell. Run constellation-install when you are ready.' ;;
    *) constellation-install ;; esac
fi
